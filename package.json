{
  "name": "@lactose/milk-orm",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/parkerfreestone/milk-orm"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir build --target bun && tsc"
  },
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./core": {
      "import": "./build/orm/schema/columnHelpers.js",
      "require": "./build/orm/schema/columnHelpers.js",
      "types": "./build/orm/schema/columnHelpers.d.ts"
    },
    "./runtime": {
      "import": "./build/orm/query/select.js",
      "require": "./build/orm/query/select.js",
      "types": "./build/orm/query/select.d.ts"
    }
  },
  "files": [
    "build/",
    "templates/"
  ],
  "bin": {
    "milk": "build/cli.js"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "fs-extra": "^11.3.0",
    "reflect-metadata": "^0.2.2"
  }
}
