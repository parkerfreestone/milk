{
  "name": "@lactose/milk-orm",
  "version": "0.2.4",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir build --target bun && tsc"
  },
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build/",
    "templates/"
  ],
  "bin": {
    "milk": "build/cli.js"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "fs-extra": "^11.3.0",
    "reflect-metadata": "^0.2.2"
  }
}
